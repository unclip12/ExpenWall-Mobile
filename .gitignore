# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VSCode (keep settings but not secrets)
#.vscode/
.vscode/launch.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 🔒 SECURITY: Firebase configuration files with API keys
# These should NEVER be committed - stored in GitHub Secrets
# and generated during build process
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# 🔑 SECURITY: Release signing keystores
# CRITICAL: Never commit keystore files
*.jks
*.keystore
key.properties
keystore-base64.txt
android/app/release-keystore.jks
android/key.properties

# Environment variables
.env
.env.local
.env.*.local

# API Keys and Secrets in Dart files
**/*secret*.dart
**/*apikey*.dart
**/*config*.dart
**/*_keys.dart

# 🤖 AI Agent workspace data — NEVER commit
# Contains full AI session history, code context, prompts
# Major privacy/IP risk if made public
.cognetivy/
.cursor/mcp.json
.claude/
.antigravity/

# Receipt images (user PII)
/receipts_local/
/test_receipts/
